# Prisma / PostgreSQL
DATABASE_URL="postgres://user:password@host/db"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-32-plus-character-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
